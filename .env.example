# RASVC-X environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is tracked,
# so NEVER put a real key here.
#
# `python -m rasvcx` loads `.env` automatically. Variables already set in
# the process environment take precedence over `.env`.
#
# Every variable below is read by src/rasvcx/config/loader.py (or the
# module named next to it). Variables not listed here are ignored.

# --- Mode ------------------------------------------------------------------
# Default (both unset): config/research_hybrid.yaml  -> real Gemini, BM25,
# Qdrant, RRF, cross-encoder reranker, NLI. Startup FAILS if any of them is
# unavailable; nothing is silently replaced by a stub.
#
# Offline test doubles are used ONLY when requested explicitly:
#   RASVCX_EXECUTION_MODE=offline_test
#
# RASVCX_CONFIG=config/research_hybrid.yaml
# RASVCX_EXECUTION_MODE=research_hybrid

# --- LLM (required in research modes) ----------------------------------------
RASVCX_LLM_API_KEY=
# Optional override of llm.model_name from the config file.
# RASVCX_LLM_MODEL=gemini-3.5-flash-lite

# --- Qdrant --------------------------------------------------------------------
# server   : Qdrant service at RASVCX_QDRANT_HOST:RASVCX_QDRANT_PORT (default)
# embedded : qdrant-client local mode persisted under RASVCX_QDRANT_PATH
# memory   : qdrant-client local mode in RAM; the dense index of the active
#            knowledge-base version is rebuilt at every startup
# RASVCX_QDRANT_MODE=server
# RASVCX_QDRANT_HOST=localhost
# RASVCX_QDRANT_PORT=6333
# RASVCX_QDRANT_PATH=data/qdrant

# --- Knowledge base (ingestion publishes versions here) -----------------------
# RASVCX_SEED_DIR=corpus        (seed index built by scripts/build_index.py)
# RASVCX_CORPUS_DIR=corpus
# RASVCX_ACTIVE_VERSION_PATH=corpus/active_version.json
# RASVCX_INGEST_DB_PATH=corpus/ingestion_jobs.db
# RASVCX_INGEST_TEMP_DIR=.runtime/ingestion_tmp

# --- API auth (only when api.require_auth: true in the config file) ----------
RASVCX_AUTH_TOKEN=

# --- Evaluation / feedback output --------------------------------------------
# RASVCX_EVAL_OUTPUT_DIR=eval_output          (api/routes_eval.py)
# RASVCX_FEEDBACK_PATH=data/feedback/feedback.jsonl   (api/routes_feedback.py)
